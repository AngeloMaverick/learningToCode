package fundamentos.operadores;

public class DesafioLogicos {
	// CTRL + ALT + A -> Edição de múltiplas linhas no Eclipse
	
	public static void main(String[] args) {
		// Trabalho na terça (V ou F)
		// Trabalho na quinta (V ou F)		
		boolean trabalho1 = true;
		boolean trabalho2 = true;
		
		// MINHA RESPOSTA
		// Se apenas um dos dois = Comprar 32pol
		boolean tv32 = trabalho1 ^ trabalho2;
		
		// Se for os dois = 50 pol
		boolean tv50 = trabalho1 && trabalho2;
		
		// Se comprou tv = familia vai tomar sorvete
		boolean tomarSorvete = tv32 || tv50;
		
		// nenhum dos dois deu certo = ficar em casa sem tv.
		boolean emCasaSemTv = !trabalho1 && !trabalho2;
		
		
		//syso qual tv 32 true, 50 true
		System.out.println("TV 32pol: " + tv32);
		System.out.println("TV 50pol: " + tv50);
		
		// syso sorvete tru ou false
		System.out.println("Tomar Sorvete: " + tomarSorvete);
		System.out.println("Em Casa sem TV: " + emCasaSemTv);
		System.out.println("\n");
		
		// Somente com || && ^ !
		
		// RESPOSTA DA AULA
		boolean comprouTv50 = trabalho1 && trabalho2;
		System.out.println("Comprou TV 50\"? " + comprouTv50);
		
	}
}
