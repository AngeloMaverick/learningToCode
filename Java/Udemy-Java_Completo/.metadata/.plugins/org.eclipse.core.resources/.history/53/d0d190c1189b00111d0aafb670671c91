package controle;

public class BreakRotulado {
	
	// É possível rotular os fors para referenciar qual você pretende dar break.
	// Porém isso não é uma prática recomendada em um desenvolvimento de software real

	public static void main(String[] args) {
		externo: for (int i = 0; i < 3; i++) {
			/* interno: */ for (int j = 0; j < 3; j++) {

				if (i == 1) {
					break externo;
					// break;
				}

				System.out.printf("[%d %d] ", i, j);
			}
			System.out.println();
		}
		System.out.println("Fim!");
	}
}
