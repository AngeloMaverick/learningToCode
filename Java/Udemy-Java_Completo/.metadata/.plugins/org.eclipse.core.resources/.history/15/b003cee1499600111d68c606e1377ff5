package fundamentos;

public class DesafioAritmeticos {
	// CTRL + SHIFT + F6 -> Altera aba
	// CTRL + SHIFT + F7 -> Altera o foco das Views do Eclipse

	public static void main(String[] args) {
		
		// Explicação
		int a = 3 * 4 - 10;
		int b = (int) Math.pow(a, 3);
		double c = Math.pow(a, 3);

		System.out.println(b);
		System.out.println(c);
		System.out.print("\n");
		
		// Minha atividade
		double n1 = Math.pow((6 * (3 + 2)), 2) / (3 * 2);
		double n2 = Math.pow((((1 - 5) * (2 - 7)) / 2), 2);
		double n3 = Math.pow(10, 3);

		System.out.println("N1 = " + n1);
		System.out.println("N2 = " + n2);
		System.out.println("N3 = " + n3);
		
		double resultado = Math.pow((n1 - n2), 3) / n3;
		System.out.println("Resultado: " + resultado);
		System.out.println("\n");
		
		// Resposta da aula
		double numA = Math.pow(6 * (3 + 2), 2);
		double denA = 3 * 2;
		
		double numB = (1 - 5) * (2 - 7);
		double denB = 2;
		
		double superiorA = numA / denA;
		double superiorB = Math.pow(numB / denB, 2);
		
		double superior = Math.pow(superiorA - superiorB, 3);
		double inferior = Math.pow(10, 3);
		
		double resultado2 = superior / inferior;
		System.out.println("O resultado é " + resultado2);	
	}
}
