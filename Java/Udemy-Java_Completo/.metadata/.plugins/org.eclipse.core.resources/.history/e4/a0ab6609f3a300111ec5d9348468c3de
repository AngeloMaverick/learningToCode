package classe;

public class Data {
	int dia;
	int mes;
	int ano;

	// Criar construtor padrão
	// Quando for chamado o construtor padrão será criado um objeto com os valores
	// 1/1/1970
	Data() {
		dia = 1;
		mes = 1;
		ano = 1970;
	}

	// Criar construtor com os 3 parametros
	Data(int diaInicial, int mesInicial, int anoInicial) {
		dia = diaInicial;
		mes = mesInicial;
		ano = anoInicial;
	}
	// Java só consegue diferenciar os construtores pela quantidade e tipo dos parametros

	String obterDataFormatada() {
		return String.format("%d/%d/%d", dia, mes, ano);
	}

	void imprimirDataFormatada() {
		System.out.println(obterDataFormatada());

		// Sempre retorne valor, pois esse tipo de método não funcionará em uma
		// aplicação desktop, web e mobile, somente em aplicação em terminal
	}

}
