package fundamentos;

public class NotacaoPonto {
	// SHIFT + ALT + Y = Word Wrap
	
	public static void main(String[] args) {
		double a = 2.3;
		// string tem que ser declarada com tipo com S maiúsculo, string com s minúsculo não existe em Java
		// palavras reservadas da linguagem são da mesma cor que "public", "static, "void", sendo elas 52.
		// String não é um tipo primitivo e não é uma palavra reservada da linguagem
	
		String s = "Bom dia X";		
		s = s.replace("X", "Senhora");
		s = s.toUpperCase();
		s = s.concat("!!!");
		
		System.out.println(s);
		
		String x = "Leo".toUpperCase();
		System.out.println(x);
		
		String y = "Bom dia X".replace("X", "Gui").toLowerCase();
		System.out.println(y);
	}
}
