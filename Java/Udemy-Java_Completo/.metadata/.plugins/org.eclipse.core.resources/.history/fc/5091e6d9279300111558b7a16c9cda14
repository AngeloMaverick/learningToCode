package fundamentos;

/*
	Byte  = 1 Byte (-128 até +127) = 8 bits
	Short = 2 Bytes (-32.768 até +32.767) = 16 bits
	Int   = 4 Bytes (-2.147.483.648 a +2.147.483.647) = 32 bits
	
	Long  = 8 Bytes = 64 bits
	( -9.223.372.036.854.775.808 a +9.223.372.036.854.775.807)
	
	Float  = 4 Bytes = precisão de cerca de 7 dígitos decimais
	Double = 8 Bytes = precisão de cerca de 15 a 17 dígitos decimais
	
	Char - '?', 'a', '1'
	Boolean - false, true
*/

public class TiposPrimitivos {
	public static void main(String[] args) {
		// Informações do funcionário
		
		// Tipos numéricos inteiros
		byte anosDeEmpresa = 23;
		short numeroDeVoos = 542;
		int id = 56789;
		
		// Declaração de um literal Long. Se não declarar o L ele entenderá que é um inteiro
		// É possível digitar números grandes com undelines no lugar do ponto para facilitar a leitura
		long pontosAcumulados = 2_234_845_223L; 
		
		// Tipos numéricos reais
		// Declarando um literal Float ao invés do padrão Double
		float salario = 11_445.44F;
	}
}
