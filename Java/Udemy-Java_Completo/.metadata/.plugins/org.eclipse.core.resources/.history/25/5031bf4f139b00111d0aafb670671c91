package controle.switches;

public class SwitchComBreak {

	public static void main(String[] args) {

		Scanner entrada = new Scanner(System.in);

		String conceito = "";
		int nota = 7;

		switch (nota) {
		case 10:
			conceito = "A";
			break;
		}

		System.out.println("Conceito é " + conceito);
		entrada.close();
	}
}
