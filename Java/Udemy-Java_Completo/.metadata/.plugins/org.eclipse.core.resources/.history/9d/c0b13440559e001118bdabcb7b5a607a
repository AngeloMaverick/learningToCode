package controle.exercicios;

import java.util.Scanner;

public class Exercicio4 {

	// Criar um programa que receba um número e diga se ele é um número primo.
	// (Número que só é divisível por 1 ou ele mesmo)
	public static void main(String[] args) {
		Scanner entrada = new Scanner(System.in);

		System.out.print("Insira um número: ");
		int numero = entrada.nextInt();

		int i;

		for (i = 2; i < numero; i++) {
			if (numero % i == 0) {
				System.out.println("Número NÃO é primo");
				break;
			}
		}

		if (i == numero || numero == 1) {
			System.out.println("Número É PRIMO");
		}

		System.out.println("Fim!");
		entrada.close();
	}
}
