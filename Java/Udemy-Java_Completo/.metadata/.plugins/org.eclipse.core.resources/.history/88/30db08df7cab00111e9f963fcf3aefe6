package classe;

public class PrimeiroTrauma {

	int a = 3;
	static int b = 4;

	public static void main(String[] args) {

		PrimeiroTrauma traumatico = new PrimeiroTrauma();
		System.out.println(traumatico.a);

		System.out.println(b);
		
		// Algo static pode acessar algo static
		// Se não for um atributo static precisa criar uma instancia para acessá-lo
	}
}
