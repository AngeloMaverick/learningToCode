package fundamentos;

import java.util.Scanner;

public class DesafioConversao {

	public static void main(String[] args) {
		// Criar Scanner
		Scanner teclado = new Scanner(System.in);
		
		// Pegar 3 últimos salários (string) com nextline
		System.out.print("Insira o primeiro salário: R$");
		Double primeiroSalario = Double.parseDouble(teclado.nextLine().replace(",", "."));
		
		System.out.print("Insira o segundo salário: R$");
		Double segundoSalario = Double.parseDouble(teclado.nextLine().replace(",", "."));
		
		System.out.print("Insira o terceiro salário: R$");
		Double terceiroSalario = Double.parseDouble(teclado.nextLine().replace(",", "."));
		
		// Calcular a média
		Double media = (primeiroSalario + segundoSalario + terceiroSalario) / 3;
		
		System.out.println("Salário 1: R$" + primeiroSalario.toString().replace(".", ","));
		System.out.println("Salário 2: R$" + segundoSalario.toString().replace(".", ","));
		System.out.println("Salário 3: R$" + terceiroSalario.toString().replace(".", ","));
		System.out.println("Média Salarial: R$" + media.toString().replace(".", ","));
		
		teclado.close();
		
		// Pode separar as casas decimais com vírgula ou usando ponto
		// 8343.65 ou 8343,67
		// [OK] Foi utilizado o .replace no retorno de cada nextLine()
				
		// Converter String em valor numérico [OK]
	}
}
