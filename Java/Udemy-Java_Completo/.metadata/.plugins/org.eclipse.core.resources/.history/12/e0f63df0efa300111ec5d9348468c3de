package classe;

public class Produto {

	String nome;
	double preco;
	double desconto;
	
	// Construtores não podem ter tipo de retorno, nem mesmo void, pois se não ele
		// se tornará um método da classe, mesmo tendo um nome de construtor.
		Produto() {

		}

	Produto(String nomeInicial) {
		nome = nomeInicial;
	}

	Produto(String nomeInicial, double precoInicial) {
		nome = nomeInicial;
		preco = precoInicial;
	}

	

	double precoComDesconto() {
		return preco * (1 - desconto);
	}

	double precoComDesconto(double descontoDoGerente) {
		return preco * (1 - (desconto + descontoDoGerente));
	}
}
